# Demo binds to loopback and uses fictional payments plus a local mail outbox.
DEMO=1
RAZORPAY_TEST=0
PORT=8108
PAYMENT_MODE=manual

# For production, change DEMO to 0 and configure the following.
# Register your sending domain with Resend and use HTTPS for PUBLIC_URL.
PUBLIC_URL=
DATA_DIR=
# Absolute path outside the checkout. Generate with npm run staff:create.
STAFF_FILE=
# Set to 1 only behind a loopback reverse proxy that sets its own X-Forwarded-For.
TRUST_LOOPBACK_PROXY=0
# Temporarily pause outbound messages during a database restore or staging rehearsal.
MAIL_PAUSED=0
PRICES_CONFIRMED=false
BASIC_FEE=800
IPC_FEE=2500
ANTIBIOTIC_FEE=2200
BEYOND_FEE=4999
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
MANUAL_UPI_ID=
MANUAL_PAYEE=
# Optional path to the organizer's verified PNG QR code, stored outside public/.
MANUAL_QR_FILE=
RESEND_API_KEY=
MAIL_FROM=
REPLY_TO=mams.microbemashup@gmail.com
WHATSAPP_URL=
# Start above the highest existing attendee number if the old form assigned IDs.
FIRST_ATTENDEE_NUMBER=1
