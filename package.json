{
  "name": "microbe-mashup-registration",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "check-razorpay": "node --env-file-if-exists=.env server.mjs check-razorpay",
    "check-brevo": "node --env-file-if-exists=.env server.mjs check-brevo",
